<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Dark theme using Material 3 -->
    <style name="Theme.Operit" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color - slightly lighter for dark mode -->
        <item name="colorPrimary">#E8DCC8</item>
        <item name="colorOnPrimary">#1C1C1C</item>
        <item name="colorPrimaryContainer">#5C4033</item>
        <item name="colorOnPrimaryContainer">#FFDCC8</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#E8DCC8</item>
        <item name="colorOnSecondary">#1C1C1C</item>
        <item name="colorSecondaryContainer">#3D4A3A</item>
        <item name="colorOnSecondaryContainer">#D0E8C8</item>

        <!-- Tertiary color -->
        <item name="colorTertiary">#E8DCC8</item>
        <item name="colorOnTertiary">#1C1C1C</item>
        <item name="colorTertiaryContainer">#4A5048</item>
        <item name="colorOnTertiaryContainer">#C4D0C5</item>

        <!-- Error color -->
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">#FFDAD6</item>

        <!-- Background color - dark -->
        <item name="android:colorBackground">#1C1C1C</item>
        <item name="colorOnBackground">#E6E3DB</item>

        <!-- Surface color -->
        <item name="colorSurface">#1C1C1C</item>
        <item name="colorOnSurface">#E6E3DB</item>
        <item name="colorSurfaceVariant">#3A3A36</item>
        <item name="colorOnSurfaceVariant">#CAC5C0</item>

        <!-- Outline color -->
        <item name="colorOutline">#948F84</item>
        <item name="colorOutlineVariant">#3A3A36</item>

        <!-- Inverse colors -->
        <item name="colorSurfaceInverse">#E6E3DB</item>
        <item name="colorOnSurfaceInverse">#1C1C1C</item>
        <item name="colorPrimaryInverse">#5C4033</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">#1C1C1C</item>
        <item name="android:navigationBarColor">#1C1C1C</item>

        <!-- Window settings -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Splash screen theme for dark mode -->
    <style name="Theme.Operit.Splash" parent="Theme.Operit">
        <item name="android:windowBackground">@color/md_sys_color_background</item>
    </style>

</resources>
